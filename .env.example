# ---- Supabase (lifetime data: accounts, profiles, notifications) ----------
# Optional. Without these, the app runs in DEMO MODE (mock auth + localStorage)
# so it still deploys and works. To enable real, permanent accounts & data:
#   1. Create a free project at https://supabase.com
#   2. Run supabase/schema.sql in the SQL Editor (one time)
#   3. Copy Settings -> API values here AND into Vercel -> Settings -> Env Vars
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- Resend (outgoing email: invites, welcome emails) ----------------------
# Optional. Without it, emails are simulated (flows still work).
#   1. Create a free account at https://resend.com -> API Keys
#   2. Add the key here and in Vercel. EMAIL_FROM must be a verified sender
#      (resend.dev sandbox sender works for testing).
RESEND_API_KEY=re_YOUR_KEY
EMAIL_FROM="Amal & Company Portal <onboarding@resend.dev>"
