# Supabase — optional. Without these, the app runs in DEMO MODE (mock auth) so it
# still deploys and works. Add them (locally as .env.local, and in Vercel →
# Project → Settings → Environment Variables) to enable real sign-in/sign-up.
#
# Find these in your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
