# ---- Supabase (lifetime data: accounts, profiles, notifications) ----------
# Optional. Without these, the app runs in DEMO MODE (mock auth + localStorage)
# so it still deploys and works. To enable real, permanent accounts & data:
#   1. Create a free project at https://supabase.com
#   2. Run supabase/schema.sql in the SQL Editor (one time)
#   3. Copy Settings -> API values here AND into Vercel -> Settings -> Env Vars
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use whichever key your dashboard shows — the new publishable key…
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# …or the legacy anon key (either one works):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# SERVER-ONLY secret (never prefixed NEXT_PUBLIC — it must NOT reach the browser).
# Enables admins to reset a user's password to a fresh temp one from People &
# Access. Without it, "Reset password" falls back to emailing a reset link.
# Supabase dashboard -> Settings -> API -> service_role key. Add it in Vercel ->
# Settings -> Environment Variables. Treat it like a root password.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Brevo (outgoing email: invites, welcome emails) ----------------------
# Optional. Without it, emails are simulated (flows still work).
#   1. Create a free account at https://brevo.com
#   2. Settings -> SMTP & API -> API Keys -> Generate a new API key
#   3. Add the key here and in Vercel. EMAIL_FROM must use a verified sender
#      (Brevo -> Senders, Domains & Dedicated IPs -> add & verify your sender).
BREVO_API_KEY=xkeysib-YOUR_KEY
EMAIL_FROM="Amal & Company Portal <noreply@amalandcompany.com>"

# ---- Claude (AI Assistant — Theory of Change Coach) ------------------------
# Optional. Without it, the AI Assistant runs in a guided demo mode.
#   Get a key at https://console.anthropic.com -> API Keys, then add it here
#   and in Vercel. Uses the claude-opus-4-8 model.
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY
