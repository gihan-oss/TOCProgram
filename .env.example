# ---- PostgreSQL (lifetime data: accounts, profiles, notifications) ---------
# Required in Docker. Without DATABASE_URL, the app runs in DEMO MODE (mock
# auth + localStorage) so it still works for local development.
# In Docker, this is set automatically by docker-compose.yml.
DATABASE_URL=postgresql://toc_user:toc_password_change_me@db:5432/toc_db

# ---- Auth (session signing + Google OAuth) ----------------------------------
# AUTH_SECRET is REQUIRED for session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=please_set_a_long_random_auth_secret
# Optional. Google Sign-In button appears on the login page when set.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ---- Brevo (outgoing email: invites, welcome emails) ----------------------
# Optional. Without it, emails are simulated (flows still work).
#   1. Create a free account at https://brevo.com
#   2. Settings -> SMTP & API -> API Keys -> Generate a new API key
#   3. Add the key here. EMAIL_FROM must use a verified sender
#      (Brevo -> Senders, Domains & Dedicated IPs -> add & verify your sender).
BREVO_API_KEY=xkeysib-YOUR_KEY
EMAIL_FROM="Amal & Company Portal <noreply@amalandcompany.com>"

# ---- Claude (AI Assistant — Theory of Change Coach) ------------------------
# Optional. Without it, the AI Assistant runs in a guided demo mode.
#   Get a key at https://console.anthropic.com -> API Keys, then add it here.
#   Uses the claude-opus-4-8 model.
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY
